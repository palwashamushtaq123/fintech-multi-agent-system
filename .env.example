# Copy this file to '.env' and insert your actual API keys.

# NEVER commit your actual '.env' file to GitHub!

GOOGLE_API_KEY=your_primary_google_gemini_api_key_here

# Optional: Secondary backup keys for rotation strategy

GOOGLE_API_KEY_1=your_backup_google_api_key_1
GOOGLE_API_KEY_2=your_backup_google_api_key_2